# Production configuration; keep actual values in ignored .env.local or host secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Contents of the credentials private_key field, not a file path; escaped \n supported.
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
CRON_SECRET=
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
# Canonical application origin used for invitation redirect URLs.
APP_ORIGIN=http://localhost:3000
# Optional nonsecret inputs for trusted first-Admin bootstrap (existing Auth user).
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_NAME=

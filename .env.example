# New independent installation; see docs/setup/README.md.
APP_ENV=production
NEXT_PUBLIC_PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_GOOGLE_SPREADSHEET_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Contents of the credentials private_key field, not a file path; escaped \n supported.
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
CRON_SECRET=
# Canonical application origin used for invitation redirect URLs.
APP_ORIGIN=http://localhost:3000
# Optional nonsecret inputs for trusted first-Admin bootstrap (existing Auth user).
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_NAME=
# Preview/staging only; never copy production credentials into these environments.
NEXT_PUBLIC_STAGING_SUPABASE_PROJECT_REF=
STAGING_GOOGLE_SPREADSHEET_ID=
